{
  "name": "rt60-react",
  "version": "1.0.0",
  "description": "RT60 (Reverberation Time) measurement for React using Web Audio API",
  "main": "dist/index.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "rollup -c",
    "dev": "rollup -c -w",
    "test": "jest",
    "lint": "eslint src/**/*.{ts,tsx}",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "rt60",
